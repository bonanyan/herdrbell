    "settings.iconStyle.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Symbolsatz für Agentenstatus und das Symbol in der Menüleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the icon set used for agent statuses and the menu bar symbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le jeu d'icônes utilisé pour les états des agents et le symbole de la barre des menus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट स्थितियों और मेनू बार प्रतीक के लिए आइकन सेट चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの状態とメニューバーのシンボルに使うアイコンセットを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 상태와 메뉴 막대 기호에 사용할 아이콘 세트를 선택하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn bộ biểu tượng dùng cho trạng thái agent và biểu tượng trên thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择用于代理状态和菜单栏图标的图标集。"
          }
        }
      }
    },
