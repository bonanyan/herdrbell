    "settings.language.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Anzeigesprache für Menüs, Einstellungen und Mitteilungen. Wird sofort übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the display language for menus, settings, and notifications. Applies immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la langue d'affichage des menus, des réglages et des notifications. S'applique immédiatement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेन्यू, सेटिंग्स और सूचनाओं के लिए प्रदर्शन भाषा चुनें। तुरंत लागू होती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー・設定・通知の表示言語を選択します。すぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴, 설정, 알림에 사용할 표시 언어를 선택하세요. 즉시 적용됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ hiển thị cho menu, cài đặt và thông báo. Áp dụng ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择菜单、设置和通知的显示语言，立即生效。"
          }
        }
      }
    },
    "settings.launchAtLogin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HerdrBell bei der Anmeldung starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch HerdrBell at login"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer HerdrBell à la connexion"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगइन पर HerdrBell चालू करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に HerdrBell を起動する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인할 때 HerdrBell 실행"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi chạy HerdrBell khi đăng nhập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动 HerdrBell"
          }
        }
      }
    },
    "settings.notifications": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilung senden, wenn ein Agent blockiert oder fertig ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when an agent becomes blocked or done"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier lorsqu'un agent est bloqué ou terminé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई एजेंट अवरुद्ध या पूर्ण हो तो सूचित करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがブロックまたは完了したときに通知する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 차단되거나 완료되면 알림 보내기"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo khi agent bị chặn hoặc hoàn tất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当代理被阻塞或完成时发送通知"
          }
        }
      }
